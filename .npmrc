# next-auth@5.0.0-beta.29 still declares a peer range of next@^14 || ^15, while
# this project runs next@16. npm v7+ treats that as a hard install failure, so
# `npm install` exits with ERESOLVE before a single package lands - which is
# what left CI red from Phase 2 onwards, with every subsequent step reporting
# "command not found".
#
# The conflict is a stale peer declaration in a beta, not a real runtime
# incompatibility, so we fall back to npm's pre-v7 resolution instead of
# pinning Next back to 15.
#
# Remove this line once next-auth ships a version whose peer range admits
# Next 16, and switch CI to `npm ci`.
legacy-peer-deps=true
