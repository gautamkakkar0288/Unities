# Public base URL of the app (absolute links, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/cirqles

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Separate database for the integration test suite. When unset, the tests that
# need Postgres skip themselves rather than failing.
TEST_DATABASE_URL=

# Exposes /prototype and /design, which render fabricated fixture data and
# include a non-functional payment screen. Defaults to on in development and
# off in production; set to true only on a preview you intend to share.
ENABLE_PROTOTYPE=
