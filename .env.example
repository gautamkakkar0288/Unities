# Public base URL of the app (absolute links, OG tags)
# Verification links are built from this, so a wrong value here sends students
# to a host that cannot redeem their token.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/cirqles

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Separate database for the integration test suite. When unset, the tests that
# need Postgres skip themselves rather than failing.
TEST_DATABASE_URL=

# Exposes /prototype and /design, which render fabricated fixture data and
# include a non-functional payment screen. Defaults to on in development and
# off in production; set to true only on a preview you intend to share.
ENABLE_PROTOTYPE=

# Email delivery (SMTP via Nodemailer)
#
# When these variables are absent the application falls back to the console
# transport: verification links are printed to the dev-server log and no
# message is delivered. The console transport throws in production so a
# misconfigured deployment fails loudly on the first send.
#
# For development: leave blank (console transport is used automatically).
# For staging/production: supply all five variables.
#
# Tested providers: any SMTP relay (Postmark, Resend SMTP, Mailgun, Zoho).
# Use port 587 + STARTTLS (secure=false) for most providers.
# Use port 465 + SMTPS  (secure=true)  for SSL-only providers.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password_here
# SMTP_FROM=noreply@cirqles.com

